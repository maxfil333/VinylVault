# Last.fm
API_KEY=

# Selectel S3 / CDN
s3_user=
s3_password=
s3_access_key=
s3_secret_key=
s3_endpoint=
s3_base_domain=
# s3_bucket=vinyl

# MongoDB root (docker MONGO_INITDB_*; used in MONGO_URI)
MONGO_ROOT_USER=vinyl
MONGO_ROOT_PASSWORD=change-me
# Host / local app (outside compose network). In compose app overrides host to "mongo".
MONGO_URI=mongodb://vinyl:change-me@127.0.0.1:27017/?authSource=admin&directConnection=true

# mongo-express UI (dev profile only: docker compose --profile dev up -d)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
ME_COOKIE_SECRET=change-me-cookie-secret
ME_SESSION_SECRET=change-me-session-secret

# ------------------------------ Прод за HTTPS-прокси ------------------------------
# COOKIE_SECURE=true обязателен, если сайт открыт по HTTPS (иначе cookie сессии уйдёт и по HTTP).
# Локально по http://localhost оставить false, иначе браузер не сохранит cookie.
COOKIE_SECURE=false
# Кому верим в X-Forwarded-* (схема запроса и IP клиента для rate limit).
# "*" безопасно, только если порт app не опубликован наружу (APP_BIND_HOST=127.0.0.1).
FORWARDED_ALLOW_IPS=127.0.0.1
# Публиковать /docs, /redoc, /openapi.json (на проде держать false)
ENABLE_DOCS=false
# Интерфейс хоста для порта 8000 в docker compose
APP_BIND_HOST=127.0.0.1

# Логи: уровень, ротация и срок хранения архивов в /app/__logs (volume app_logs)
LOG_LEVEL=INFO
LOG_ROTATION="5 MB"
LOG_RETENTION="14 days"

# Кэш ответов Last.fm, секунды (берёт квоту внешнего API)
SEARCH_CACHE_TTL_SEC=300
