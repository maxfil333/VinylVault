# Last.fm
API_KEY=

# Selectel S3 / CDN
s3_user=
s3_password=
s3_access_key=
s3_secret_key=
s3_endpoint=
s3_base_domain=
# s3_bucket=vinyl

# MongoDB root (docker MONGO_INITDB_*; used in MONGO_URI)
MONGO_ROOT_USER=vinyl
MONGO_ROOT_PASSWORD=change-me
# Host / local app (outside compose network). In compose app overrides host to "mongo".
MONGO_URI=mongodb://vinyl:change-me@127.0.0.1:27017/?authSource=admin&directConnection=true

# mongo-express UI (http://localhost:8081/mongo)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
ME_COOKIE_SECRET=change-me-cookie-secret
ME_SESSION_SECRET=change-me-session-secret
